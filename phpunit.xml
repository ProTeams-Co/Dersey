<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <!--
                MySqlOnly: tests that genuinely cannot run on SQLite, not
                just "slower there" - e.g. ProductTranslationFullTextTest
                needs Illuminate\Foundation\Testing\DatabaseMigrations (a
                real commit for InnoDB to update its FULLTEXT index, which
                RefreshDatabase's per-test rollback never provides), and
                DatabaseMigrations' down()-migration teardown hits an
                unrelated pre-existing SQLite incompatibility
                (`ALTER TABLE ... DROP COLUMN` on an indexed column) that
                RefreshDatabase never exercises since it doesn't roll back
                the schema, only the data. See phpunit.mysql.xml / CLAUDE.md
                §18 - this directory only runs under `composer test:mysql`.
            -->
            <exclude>tests/Feature/MySqlOnly</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
