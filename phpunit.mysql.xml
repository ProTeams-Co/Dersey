<?xml version="1.0" encoding="UTF-8"?>
<!--
    Runs the suite against a real MySQL connection instead of SQLite -
    SQLite tolerates several things MySQL rejects outright (e.g. ORDER BY
    on a column that doesn't exist on the table silently no-ops with a
    LIMIT present, where MySQL throws "Unknown column"; a fullText() index
    can't even be created on SQLite at all). See CLAUDE.md's "SQLite vs
    MySQL" note for the full rationale.

    `dersey_testing` is a SEPARATE database from the dev `dersey` one
    (config/database.php's mysql connection, same host/user/password from
    .env) - RefreshDatabase migrates it fresh on every run, so it must
    never be pointed at real dev/prod data. Create it once:

        mysql -u root -e "CREATE DATABASE IF NOT EXISTS dersey_testing"

    Usage: composer test:mysql (runs only the `mysql-critical` group - see
    CLAUDE.md for which tests carry that tag and why). To run the full
    suite against MySQL instead: vendor/bin/pest -c phpunit.mysql.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="dersey_testing"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
